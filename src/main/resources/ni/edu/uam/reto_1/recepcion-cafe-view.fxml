<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #E0E5EC;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.reto_1.modelos.RecepcionCafeController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Recepción de Lotes de Café" />

    <GridPane alignment="CENTER" hgap="10" vgap="10">
        <Label text="ID Lote:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtIdLote" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Productor:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtProductor" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Quintales (QQ):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtQuintales" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Variedad:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="txtVariedad" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Fecha Entrega:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <DatePicker fx:id="dpFechaEntrega" GridPane.columnIndex="1" GridPane.rowIndex="4" />
      <columnConstraints>
         <ColumnConstraints />
         <ColumnConstraints />
      </columnConstraints>
      <rowConstraints>
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>
    </GridPane>

    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="btnGuardar" onAction="#guardarLoteOnClick" text="Guardar Lote" />
        <Button fx:id="btnLimpiar" onAction="#limpiarFormulario" text="Limpiar" />
    </HBox>

    <!-- TableView con MouseEvent para mostrar detalles -->
    <TableView fx:id="tablaLotes" onMouseClicked="#seleccionarLoteTabla" prefHeight="200.0" prefWidth="500.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="75" text="ID Lote" />
            <TableColumn fx:id="colProductor" prefWidth="130" text="Productor" />
            <TableColumn fx:id="colQuintales" prefWidth="80" text="Quintales" />
            <TableColumn fx:id="colVariedad" prefWidth="100" text="Variedad" />
            <TableColumn fx:id="colFecha" prefWidth="100" text="Fecha" />
        </columns>
    </TableView>

    <Label fx:id="lblEstado" style="-fx-text-fill: gray;" text="Haz clic derecho sobre una fila de la tabla para ver opciones." />
</VBox>
