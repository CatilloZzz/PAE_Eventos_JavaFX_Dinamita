<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.reto_1.controller.Reto3Controller"
            maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="600.0">
   <top>
      <VBox prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <MenuBar style="-fx-background-color: #E0E5EC; -fx-border-color: transparent;">
              <menus>
                <Menu mnemonicParsing="false" text="Catálogo">
                  <items>
                    <MenuItem mnemonicParsing="false" text="Close" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Ventas">
                  <items>
                    <MenuItem mnemonicParsing="false" text="Delete" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Ayuda">
                  <items>
                    <MenuItem mnemonicParsing="false" text="Acerca de...." />
                  </items>
                </Menu>
              </menus>
            </MenuBar>
            <ToolBar prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #E0E5EC; -fx-border-color: transparent;">
              <items>
                  <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #E0E5EC; -fx-background-radius: 8; -fx-text-fill: #4a4a4a; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, #a3b1c6, 6, 0, 3, 3);" text="Nuevo">
                     <opaqueInsets>
                        <Insets left="5.0" />
                     </opaqueInsets></Button>
                <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #E0E5EC; -fx-background-radius: 8; -fx-text-fill: #4a4a4a; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, #a3b1c6, 6, 0, 3, 3);" text="Guardar ">
                     <opaqueInsets>
                        <Insets left="5.0" />
                     </opaqueInsets></Button>
                  <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #E0E5EC; -fx-background-radius: 8; -fx-text-fill: #4a4a4a; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, #a3b1c6, 6, 0, 3, 3);" text="Buscar">
                     <opaqueInsets>
                        <Insets left="5.0" />
                     </opaqueInsets></Button>
              </items>
            </ToolBar>
         </children>
      </VBox>
   </top>
   <center>
       <TableView fx:id="tablaArtesanias" prefHeight="200.0" prefWidth="200.0">
           <columns>
               <TableColumn fx:id="colImagen" prefWidth="75.0" text="Imagen" />
               <TableColumn fx:id="colCodigo" prefWidth="75.0" text="Código" />
               <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
               <TableColumn fx:id="colPrecio" prefWidth="75.0" text="Precio" />
           </columns>
           <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
           </columnResizePolicy>
       </TableView>
   </center>
</BorderPane>
